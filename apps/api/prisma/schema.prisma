generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model CrawlSource {
  id                  Int      @id @default(autoincrement())
  name                String   @unique
  baseUrl             String
  isActive            Boolean  @default(true)
  defaultDelayMs      Int      @default(2000)
  maxVacanciesToCrawl Int      @default(25)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  runs     CrawlRun[]
  listings CrawlListing[]

  @@map("crawl_sources")
}

// A named, independently-crawlable sub-target within a CrawlSource (e.g. one category of a job
// board) - additive, not required: a source with no listings is still crawled directly at the
// source level exactly as before. See .claude/features/09_FEATURE_CRAWL_LISTINGS.md.
model CrawlListing {
  id        Int         @id @default(autoincrement())
  sourceId  Int
  source    CrawlSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  label     String
  subPath   String
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  runs CrawlRun[]

  @@unique([sourceId, subPath])
  @@map("crawl_listings")
}

model CrawlRun {
  id             Int         @id @default(autoincrement())
  sourceId       Int
  listingId      Int?
  status         CrawlStatus @default(PENDING)
  vacanciesFound Int         @default(0)
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  source  CrawlSource   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  listing CrawlListing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
  logs    CrawlLog[]

  @@map("crawl_runs")
}

enum CrawlStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  STOPPED
}

model CrawlLog {
  id        Int      @id @default(autoincrement())
  runId     Int
  level     LogLevel @default(INFO)
  message   String
  createdAt DateTime @default(now())

  run CrawlRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@map("crawl_logs")
}

enum LogLevel {
  INFO
  WARN
  ERROR
}
